{
  "css": {
    "at-rules": {
      "mixin": {
        "__compat": {
          "spec_url": "https://drafts.csswg.org/css-mixins-1/#mixin-rule",
          "support": {
            "chrome": {
              "version_added": "141",
              "flags": [
                {
                  "type": "preference",
                  "name": "#enable-experimental-web-platform-features",
                  "value_to_set": "Enabled"
                }
              ]
            },
            "chrome_android": "mirror",
            "edge": "mirror",
            "firefox": {
              "version_added": false
            },
            "firefox_android": "mirror",
            "oculus": "mirror",
            "opera": "mirror",
            "opera_android": "mirror",
            "safari": {
              "version_added": false
            },
            "safari_ios": "mirror",
            "samsunginternet_android": "mirror",
            "webview_android": "mirror",
            "webview_ios": "mirror"
          },
          "status": {
            "experimental": true,
            "standard_track": true,
            "deprecated": false
          }
        }
      }
    }
  }
}
