{
  "css": {
    "at-rules": {
      "scope": {
        "__compat": {
          "description": "`@scope`",
          "mdn_url": "https://developer.mozilla.org/docs/Web/CSS/Reference/At-rules/@scope",
          "spec_url": "https://drafts.csswg.org/css-cascade-6/#scoped-styles",
          "tags": [
            "web-features:scope"
          ],
          "support": {
            "chrome": {
              "version_added": "118"
            },
            "chrome_android": "mirror",
            "edge": "mirror",
            "firefox": {
              "version_added": "146"
            },
            "firefox_android": "mirror",
            "oculus": "mirror",
            "opera": "mirror",
            "opera_android": "mirror",
            "safari": [
              {
                "version_added": "26.4"
              },
              {
                "version_added": "26",
                "version_removed": "26.4",
                "partial_implementation": true,
                "notes": "CSS rules within `@scope` are not applied to `<input>` and `<textarea>` elements."
              },
              {
                "version_added": "17.4",
                "version_removed": "26"
              }
            ],
            "safari_ios": "mirror",
            "samsunginternet_android": "mirror",
            "webview_android": "mirror",
            "webview_ios": "mirror"
          },
          "status": {
            "experimental": false,
            "standard_track": true,
            "deprecated": false
          }
        }
      }
    }
  }
}
