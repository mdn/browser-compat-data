{
  "webextensions": {
    "manifest": {
      "icon_variants": {
        "__compat": {
          "support": {
            "chrome": {
              "version_added": "127",
              "flags": [
                {
                  "type": "runtime_flag",
                  "name": "--enable-features=ExtensionIconVariants"
                }
              ],
              "impl_url": "https://crbug.com/41419485",
              "notes": "Only available in Chrome Canary."
            },
            "edge": "mirror",
            "firefox": {
              "version_added": false,
              "impl_url": "https://bugzil.la/1955199"
            },
            "firefox_android": "mirror",
            "opera": "mirror",
            "safari": {
              "version_added": "18.2"
            },
            "safari_ios": "mirror"
          }
        },
        "any": {
          "__compat": {
            "support": {
              "chrome": {
                "version_added": "127",
                "flags": [
                  {
                    "type": "runtime_flag",
                    "name": "--enable-features=ExtensionIconVariants"
                  }
                ]
              },
              "edge": "mirror",
              "firefox": {
                "version_added": false
              },
              "firefox_android": "mirror",
              "opera": "mirror",
              "safari": {
                "version_added": "18.2",
                "impl_url": "https://webkit.org/b/330501",
                "partial_implementation": true,
                "notes": "The `any` icon is preferred over every explicit size in a group, instead of being used only when no other size is large enough."
              },
              "safari_ios": "mirror"
            }
          }
        },
        "color_schemes": {
          "__compat": {
            "support": {
              "chrome": {
                "version_added": "127",
                "flags": [
                  {
                    "type": "runtime_flag",
                    "name": "--enable-features=ExtensionIconVariants"
                  }
                ]
              },
              "edge": "mirror",
              "firefox": {
                "version_added": false
              },
              "firefox_android": "mirror",
              "opera": "mirror",
              "safari": {
                "version_added": "18.2"
              },
              "safari_ios": "mirror"
            }
          }
        }
      }
    }
  }
}
