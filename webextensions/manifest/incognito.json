{
  "webextensions": {
    "manifest": {
      "incognito": {
        "__compat": {
          "mdn_url": "https://developer.mozilla.org/docs/Mozilla/Add-ons/WebExtensions/manifest.json/incognito",
          "support": {
            "chrome": {
              "version_added": "≤58"
            },
            "edge": {
              "version_added": "≤18"
            },
            "firefox": {
              "version_added": "48"
            },
            "firefox_android": "mirror",
            "opera": "mirror",
            "safari": {
              "version_added": "14",
              "partial_implementation": true,
              "notes": [
                "Operates in spanning mode.",
                "From Safari 17, controlled by a user setting. Previously, there was no user setting."
              ]
            },
            "safari_ios": {
              "version_added": "15",
              "partial_implementation": true,
              "notes": [
                "Operates in spanning mode.",
                "From Safari on iOS 17, controlled by a user setting. Previously, there was no user setting."
              ]
            }
          }
        },
        "not_allowed": {
          "__compat": {
            "support": {
              "chrome": {
                "version_added": "≤58"
              },
              "edge": {
                "version_added": "17"
              },
              "firefox": {
                "version_added": "67"
              },
              "firefox_android": "mirror",
              "opera": "mirror",
              "safari": {
                "version_added": false,
                "impl_url": "https://webkit.org/b/280785"
              },
              "safari_ios": "mirror"
            }
          }
        },
        "spanning": {
          "__compat": {
            "support": {
              "chrome": {
                "version_added": "≤72"
              },
              "edge": {
                "version_added": "≤18"
              },
              "firefox": {
                "version_added": "48"
              },
              "firefox_android": "mirror",
              "opera": "mirror",
              "safari": {
                "version_added": false
              },
              "safari_ios": "mirror"
            }
          }
        },
        "split": {
          "__compat": {
            "support": {
              "chrome": {
                "version_added": "≤58"
              },
              "edge": {
                "version_added": "17"
              },
              "firefox": {
                "version_added": "127",
                "impl_url": "https://bugzil.la/1380812",
                "partial_implementation": true,
                "notes": "Split mode is not supported in Firefox. Extensions using this value are treated as requesting \"incognito\": \"not_allowed\"."
              },
              "firefox_android": "mirror",
              "opera": "mirror",
              "safari": {
                "version_added": false
              },
              "safari_ios": "mirror"
            }
          }
        }
      }
    }
  }
}
